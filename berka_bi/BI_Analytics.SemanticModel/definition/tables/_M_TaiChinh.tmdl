table _M_TaiChinh
	lineageTag: a27a95cd-42f3-4d4c-b37f-a7f50cff920f

	measure 'Số giao dịch' = COUNTROWS(Fact_Transaction)
		formatString: #,0
		displayFolder: 2 Giao dịch
		lineageTag: b217347b-cd6f-45e3-b907-1fcd592e3e20

	measure 'Tổng tiền vào' = ```
			
			        CALCULATE ( SUM ( Fact_Transaction[amount] ), Dim_TransType[Direction] = "Tiền vào" )
			```
		formatString: #,0.00
		displayFolder: 2 Giao dịch
		lineageTag: 0d684a73-e951-4449-be72-406cafa81c3e

	measure 'Tổng tiền ra' = ```
			
			        CALCULATE ( SUM ( Fact_Transaction[amount] ), Dim_TransType[Direction] = "Tiền ra" )
			```
		formatString: #,0.00
		displayFolder: 2 Giao dịch
		lineageTag: 83c801fd-aaf6-4ad4-b764-e6e0bbdc5870

	measure 'Dòng tiền ròng' = [Tổng tiền vào] - [Tổng tiền ra]
		formatString: #,0
		displayFolder: 1 Tổng quan
		lineageTag: 5cb2852b-5c35-49b2-b1d3-07914a035a43

	measure 'Tiền vào tháng trước' = ```
			
			        CALCULATE ( [Tổng tiền vào], DATEADD ( Dim_Date[Date], -1, MONTH ) )
			```
		formatString: #,0.00
		displayFolder: 2 Giao dịch
		lineageTag: 102176f9-a0be-4c44-9037-f7c1bbbfe95d

	measure 'Tăng trưởng tiền vào MoM %' = ```
			
			        VAR Prev = [Tiền vào tháng trước]
			        RETURN DIVIDE ( [Tổng tiền vào] - Prev, Prev )
			```
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 2 Giao dịch
		lineageTag: 9ce6576d-dd35-4cef-b96c-cfed776a7d5e

	measure 'Tiền vào YTD' = ```
			
			        TOTALYTD ( [Tổng tiền vào], Dim_Date[Date] )
			```
		formatString: #,0.00
		displayFolder: 2 Giao dịch
		lineageTag: 1a521e5b-c217-4149-8361-5c43cc9868cf

	measure 'Dòng tiền ròng YTD' = ```
			
			        TOTALYTD ( [Dòng tiền ròng], Dim_Date[Date] )
			```
		formatString: #,0.00
		displayFolder: 2 Giao dịch
		lineageTag: 8aaede4e-f247-41b9-b52e-4fa42f78bb7f

	measure 'Tổng số dư tiền gửi' = ```
			
			        VAR PeriodEnd = MAX ( Dim_Date[Date] )
			        RETURN
			            CALCULATE (
			                SUM ( Fact_Transaction[SignedAmount] ),
			                REMOVEFILTERS ( Dim_Date ),
			                Fact_Transaction[TransDate] <= PeriodEnd
			            )
			```
		formatString: #,0
		displayFolder: 1 Tổng quan
		lineageTag: 2070b852-b587-44ed-83de-698681126af2

	measure 'Số tài khoản cuối kỳ' = ```
			
			        VAR PeriodEnd = MAX ( Dim_Date[Date] )
			        RETURN
			            CALCULATE (
			                DISTINCTCOUNT ( Fact_Transaction[account_id] ),
			                REMOVEFILTERS ( Dim_Date ),
			                Fact_Transaction[TransDate] <= PeriodEnd
			            )
			```
		formatString: 0
		displayFolder: 1 Tổng quan
		lineageTag: 58b5dc1b-257a-4ea3-ad99-d84e36267167

	measure 'Số dư bình quân / tài khoản' = ```
			
			        DIVIDE ( [Tổng số dư tiền gửi], [Số tài khoản cuối kỳ] )
			```
		formatString: #,0
		displayFolder: 1 Tổng quan
		lineageTag: 37999e86-180f-450c-a74d-bcf826901c3c

	measure 'Tổng số dư cùng kỳ năm trước' = ```
			
			        CALCULATE ( [Tổng số dư tiền gửi], SAMEPERIODLASTYEAR ( Dim_Date[Date] ) )
			```
		formatString: #,0
		displayFolder: 1 Tổng quan
		lineageTag: 2e27b66d-6f60-4c99-be43-a5b1685e4c84

	measure 'Tăng trưởng số dư YoY %' = ```
			
			        VAR Prev = [Tổng số dư cùng kỳ năm trước]
			        RETURN DIVIDE ( [Tổng số dư tiền gửi] - Prev, Prev )
			```
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 1 Tổng quan
		lineageTag: 6baf3d6d-582d-4016-b260-4f3189fd6c4f

	measure 'Dư nợ cho vay cuối kỳ' = ```
			
			        VAR PeriodEnd = MAX ( Dim_Date[Date] )
			        RETURN
			            CALCULATE (
			                SUMX (
			                    FILTER ( Fact_Loan, Fact_Loan[LoanDate] <= PeriodEnd ),
			                    VAR MonthsPaid =
			                        MIN ( DATEDIFF ( Fact_Loan[LoanDate], PeriodEnd, MONTH ), Fact_Loan[duration] )
			                    RETURN
			                        MAX ( Fact_Loan[amount] - MonthsPaid * Fact_Loan[payments], 0 )
			                ),
			                REMOVEFILTERS ( Dim_Date )
			            )
			```
		formatString: #,0
		displayFolder: 1 Tổng quan
		lineageTag: 1e025d79-2cfb-48f4-9d0f-77b2af892e0c

	measure LDR = ```
			
			        DIVIDE ( [Dư nợ cho vay cuối kỳ], [Tổng số dư tiền gửi] )
			```
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 1 Tổng quan
		lineageTag: 0bf96cf4-d4f2-4c98-9f71-acd400c909c6

	measure 'Ngưỡng LDR' = 0.85
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 1 Tổng quan
		lineageTag: d6b93a95-aa36-4bef-9a9b-2cbad8c72c8d

	measure 'Thu nhập phí' = ```
			
			        CALCULATE ( SUM ( Fact_Transaction[amount] ), Dim_TransType[IsFeeIncome] = TRUE () )
			```
		formatString: #,0
		displayFolder: 1 Tổng quan
		lineageTag: 087ba5e2-83c0-4797-9f55-376fafad2326

	measure 'Chi phí lãi trả khách' = ```
			
			        CALCULATE ( SUM ( Fact_Transaction[amount] ), Dim_TransType[k_symbol] = "UROK" )
			```
		formatString: #,0
		displayFolder: 1 Tổng quan
		lineageTag: f363caf6-f247-44cf-8511-d139be81d13c

	measure 'Chênh lệch phí - lãi' = ```
			
			        [Thu nhập phí] - [Chi phí lãi trả khách]
			```
		formatString: #,0
		displayFolder: 1 Tổng quan
		lineageTag: b53a27e1-3145-49ad-a26e-f249224f5ece

	measure 'Tiêu đề xu hướng' =
			
			VAR ChiSo =
			    SUMMARIZE (
			        'Chọn chỉ số',
			        'Chọn chỉ số'[Chọn chỉ số],
			        'Chọn chỉ số'[Chọn chỉ số Fields]
			    )
			RETURN
			    "Xu hướng "
			        & IF ( COUNTROWS ( ChiSo ) = 1, MAXX ( ChiSo, 'Chọn chỉ số'[Chọn chỉ số] ), "chỉ số" )
			        & " theo tháng"
		displayFolder: 1 Tổng quan
		lineageTag: 7f905db9-3b84-4d99-97c8-d374aa9a4fa7

	measure 'Số TK từng có số dư âm' =
			
			COALESCE (
			    CALCULATE (
			        DISTINCTCOUNT ( Fact_Balance_Monthly[account_id] ),
			        Fact_Balance_Monthly[MinBalance] < 0
			    ),
			    0
			)
		formatString: #,0
		displayFolder: 2 Giao dịch
		lineageTag: 08f001c8-ce24-4009-8351-748cfb7a40d2

	measure 'Tỷ lệ TK số dư âm' = DIVIDE ( [Số TK từng có số dư âm], [Số tài khoản cuối kỳ], 0 )
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: 2 Giao dịch
		lineageTag: d41036c5-a279-4c88-b2b8-557ae679bd06

	measure 'Số giao dịch BQ mỗi ngày' = DIVIDE ( [Số giao dịch], COUNTROWS ( Dim_Date ) )
		formatString: 0.00
		displayFolder: 2 Giao dịch
		lineageTag: 4be0e0d7-f4df-43ae-b4e9-baa340eefc53

	measure 'Số giao dịch của khách' = ```
			
			        CALCULATE (
			            [Số giao dịch],
			            Dim_TransType[Channel] <> "Ngân hàng tự ghi",
			            NOT ( Dim_TransType[PurposeName] IN { "Phí sao kê", "Lãi phạt số dư âm" } )
			        )
			```
		formatString: #,0
		displayFolder: 3 Khách hàng & vùng
		lineageTag: f47427eb-3c1a-4778-995a-b361f042b77f

	measure 'Số khách hàng' = ```
			
			        VAR PeriodEnd = MAX ( Dim_Date[Date] )
			        RETURN
			            CALCULATE (
			                DISTINCTCOUNT ( Dim_Account[OwnerClientId] ),
			                Dim_Account[AccountOpenDate] <= PeriodEnd
			            )
			```
		formatString: #,0
		displayFolder: 3 Khách hàng & vùng
		lineageTag: d4960d77-4219-4f54-a317-a0ff140921a7

	measure 'Số TK hoạt động' = ```
			
			        CALCULATE (
			            DISTINCTCOUNT ( Fact_Transaction[account_id] ),
			            Dim_TransType[Channel] <> "Ngân hàng tự ghi",
			            NOT ( Dim_TransType[PurposeName] IN { "Phí sao kê", "Lãi phạt số dư âm" } )
			        )
			```
		formatString: #,0
		displayFolder: 3 Khách hàng & vùng
		lineageTag: 3672026d-22d6-4464-a649-4b3541043f48

	measure 'Số TK nhận lương hưu' =
			
			COALESCE (
			    CALCULATE (
			        DISTINCTCOUNT ( Fact_Transaction[account_id] ),
			        Dim_TransType[k_symbol] = "DUCHOD"
			    ),
			    0
			)
		formatString: #,0
		displayFolder: 3 Khách hàng & vùng
		lineageTag: 0ef3b442-7924-43b4-8a5c-c2b5099f3cd9

	measure 'Tỷ trọng TK nhận lương hưu' = ```
			
			        DIVIDE ( [Số TK nhận lương hưu], [Số tài khoản cuối kỳ], 0 )
			```
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 3 Khách hàng & vùng
		lineageTag: 56539044-2b72-42ec-9df7-58a823a326d2

	measure 'GD BQ mỗi TK mỗi tháng' = ```
			
			        DIVIDE ( [Số giao dịch của khách], COUNTROWS ( Fact_Balance_Monthly ) )
			```
		formatString: 0.0
		displayFolder: 3 Khách hàng & vùng
		lineageTag: fe69a7e4-3e33-408f-b61c-e06f7b84b15d

	measure 'Thị phần tài khoản' = ```
			
			        DIVIDE (
			            [Số tài khoản cuối kỳ],
			            CALCULATE ( [Số tài khoản cuối kỳ], REMOVEFILTERS ( Dim_District ) )
			        )

	partition ML_LoanCreditScoring = m
		mode: import
		queryGroup: Dimension
		source =
				let
				    Source = Csv.Document(
				        File.Contents(DataFolder & "ml_loan_credit_scoring.csv"),
				        [Delimiter=",", Columns=16, Encoding=65001, QuoteStyle=QuoteStyle.None]
				    ),
				    PromotedHeaders = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    ChangedType = Table.TransformColumnTypes(
				        PromotedHeaders,
				        {
				            {"loan_id", Int64.Type},
				            {"account_id", Int64.Type},
				            {"LoanAmount", Currency.Type},
				            {"LoanDuration", Int64.Type},
				            {"MonthlyPayment", Currency.Type},
				            {"DaysToLoan", Int64.Type},
				            {"AvgBalance_90d", Currency.Type},
				            {"MinBalance_90d", Currency.Type},
				            {"NegBalanceCount_90d", Int64.Type},
				            {"DSR", type number},
				            {"Status", type text},
				            {"Default", Int64.Type},
				            {"PD_Score", type number},
				            {"Risk_Group", type text},
				            {"Risk_Order", Int64.Type},
				            {"Predicted_Default", Int64.Type}
				        },
				        "en-US"
				    )
				in
				    ChangedType

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table


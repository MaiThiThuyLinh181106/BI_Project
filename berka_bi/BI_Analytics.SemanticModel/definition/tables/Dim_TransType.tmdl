	column IsFeeIncome
		dataType: boolean
		formatString: """TRUE"";""TRUE"";""FALSE"""
		lineageTag: 7f0039c3-39f1-4e01-a7b1-b9514e099578
		summarizeBy: none
		sourceColumn: IsFeeIncome

		annotation SummarizationSetBy = Automatic

	partition Dim_TransType = m
		mode: import
		queryGroup: Dimension
		source =
				let
				    Source = Fact_Transaction,
				    Selected = Table.SelectColumns(Source, {"TransTypeCode", "type", "operation", "k_symbol"}),
				    Distinct = Table.Distinct(Selected, {"TransTypeCode"}),
				
				    //dịch mã tiếng Séc
				    TypeMap = [PRIJEM = "Tiền vào", VYDAJ = "Tiền ra", VYBER = "Tiền ra"],
				    OperationMap = [
				        VKLAD = "Nộp tiền mặt",
				        VYBER = "Rút tiền mặt",
				        #"VYBER KARTOU" = "Rút tiền bằng thẻ",
				        #"PREVOD Z UCTU" = "Nhận chuyển khoản",
				        #"PREVOD NA UCET" = "Chuyển khoản đi"
				    ],
				    PurposeMap = [
				        POJISTNE = "Thanh toán bảo hiểm",
				        SLUZBY = "Phí sao kê",
				        UROK = "Lãi trả cho khách",
				        #"SANKC. UROK" = "Lãi phạt số dư âm",
				        SIPO = "Chi tiêu gia đình",
				        DUCHOD = "Lương hưu",
				        UVER = "Trả nợ vay"
				    ],
				
				    AddDirection = Table.AddColumn(Distinct, "Direction", each
				        Record.FieldOrDefault(TypeMap, [type], "Không xác định"), type text),
				    AddOperationName = Table.AddColumn(AddDirection, "OperationName", each
				        if [operation] = "" then "Ngân hàng tự ghi (lãi, phí)"
				        else Record.FieldOrDefault(OperationMap, [operation], [operation]), type text),
				    AddPurposeName = Table.AddColumn(AddOperationName, "PurposeName", each
				        if [k_symbol] = "" then "Không xác định"
				        else Record.FieldOrDefault(PurposeMap, [k_symbol], [k_symbol]), type text),
				
				    // nhóm kênh giao dịch cho câu hỏi 5
				    AddChannel = Table.AddColumn(AddPurposeName, "Channel", each
				        if [operation] = "VYBER KARTOU" then "Thẻ"
				        else if [operation] = "PREVOD Z UCTU" or [operation] = "PREVOD NA UCET" then "Chuyển khoản"
				        else if [operation] = "VKLAD" or [operation] = "VYBER" then "Tiền mặt"
				        else "Ngân hàng tự ghi", type text),
				
				    // cờ thu nhập phí cho KPI K04
				    AddIsFeeIncome = Table.AddColumn(AddChannel, "IsFeeIncome", each
				        [k_symbol] = "SLUZBY" or [k_symbol] = "SANKC. UROK", type logical)
				in
				    AddIsFeeIncome

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table


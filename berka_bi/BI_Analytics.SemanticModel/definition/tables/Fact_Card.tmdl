table Fact_Card
	lineageTag: 366ed058-dfbb-4303-b291-86122b2fdd10

	column card_id
		dataType: int64
		formatString: 0
		lineageTag: f103c044-cc8a-4bd5-a12b-7d745f8e113f
		summarizeBy: none
		sourceColumn: card_id

		annotation SummarizationSetBy = User

	column disp_id
		dataType: int64
		formatString: 0
		lineageTag: 1d4646cf-a60b-48bd-86de-27d5577ea655
		summarizeBy: none
		sourceColumn: disp_id

		annotation SummarizationSetBy = Automatic

	column type
		dataType: string
		lineageTag: b5d27e37-d549-4e8d-88ce-4fdc96478880
		summarizeBy: none
		sourceColumn: type

		annotation SummarizationSetBy = Automatic

	column CardIssuedDate
		dataType: dateTime
		formatString: Long Date
		lineageTag: 4dee56da-298e-47b7-bec7-de79168c8522
		summarizeBy: none
		sourceColumn: CardIssuedDate

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	partition Fact_Card = m
		mode: import
		queryGroup: Fact
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "card.csv"), [Delimiter=";", Columns=4, Encoding=1252, QuoteStyle=QuoteStyle.None]),
				    #"Promoted Headers" = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    #"Trimmed Text" = Table.TransformColumns(#"Promoted Headers", {
				        {"type", Text.Trim, type text},
				        {"issued", Text.Trim, type text}
				    }),
				    #"Changed Type Base" = Table.TransformColumnTypes(#"Trimmed Text", {
				        {"card_id", Int64.Type},
				        {"disp_id", Int64.Type},
				        {"type", type text},
				        {"issued", type text}
				    }),
				
				    // Cắt 6 ký tự đầu của chuỗi (bỏ phần giờ 00:00:00) rồi chuyển sang kiểu date
				    #"Added IssuedDate" = Table.AddColumn(#"Changed Type Base", "CardIssuedDate", each
				        let
				            rawDateText = Text.Start([issued], 6),
				            rawDateNum = Number.FromText(rawDateText),
				            y = 1900 + Number.IntegerDivide(rawDateNum, 10000),
				            m = Number.Mod(Number.IntegerDivide(rawDateNum, 100), 100),
				            d = Number.Mod(rawDateNum, 100)
				        in
				            #date(y, m, d), type date),
				    #"Removed Raw Issued" = Table.RemoveColumns(#"Added IssuedDate", {"issued"}),
				    #"Reordered Columns" = Table.ReorderColumns(#"Removed Raw Issued", {"card_id", "disp_id", "CardIssuedDate", "type"})
				in
				    #"Reordered Columns"

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table


	column LoanDate
		dataType: dateTime
		formatString: Long Date
		lineageTag: 84dcda36-2c19-4b62-b47f-844631575872
		summarizeBy: none
		sourceColumn: LoanDate

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	column MaturityDate
		dataType: dateTime
		formatString: Long Date
		lineageTag: edf4a8b2-29af-4abd-ada5-5c33e1c2aa79
		summarizeBy: none
		sourceColumn: MaturityDate


table Fact_Loan
	lineageTag: 0a61b5a7-cf9b-45ea-8eff-f6910cadff8a

	column loan_id
		dataType: int64
		formatString: 0
		lineageTag: eee54d4d-bd5c-498a-8d5c-eeacf2d78a0d
		summarizeBy: sum
		sourceColumn: loan_id

		annotation SummarizationSetBy = Automatic

	column account_id
		dataType: int64
		formatString: 0
		lineageTag: 36c4b11e-97a7-4258-a7ea-02338ad3b1be

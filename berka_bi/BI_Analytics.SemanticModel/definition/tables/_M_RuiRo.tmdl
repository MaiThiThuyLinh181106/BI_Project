table _M_RuiRo
	lineageTag: 3dcd7fa8-766c-4a48-a58d-b90fdfbfb4e3

	measure 'Total Loans' = COUNTROWS(Fact_Loan)
		formatString: #,0
		displayFolder: 5 Danh mục cho vay
		lineageTag: dc9a49f7-c2b6-42f8-90bc-e5438218bd9c

	measure 'Total Loan Amount' = SUM(Fact_Loan[amount])
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		displayFolder: 5 Danh mục cho vay
		lineageTag: c48371fb-e3a5-4e2e-b095-732329687dcc

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Average Loan Amount' = DIVIDE([Total Loan Amount], [Total Loans], 0)
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		displayFolder: 5 Danh mục cho vay
		lineageTag: cf08c6b4-5b7f-4b2d-9627-94e3661d8d80

	measure 'Average Monthly Payment' = AVERAGE(Fact_Loan[payments])
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		displayFolder: 5 Danh mục cho vay
		lineageTag: 7b8e11c5-61db-400d-a9a5-0369fe3349ec

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Loan Penetration Rate' =
			
			DIVIDE(
			    DISTINCTCOUNT(Fact_Loan[account_id]),
			    DISTINCTCOUNT(Dim_Account[account_id]),
			    0
			)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: 5 Danh mục cho vay
		lineageTag: 18da9852-744d-470a-bb1e-89ac5d5c3f5f

	measure 'Estimated Outstanding Debt' = SUM(Fact_Loan[EstimatedOutstandingBalance])
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		displayFolder: 5 Danh mục cho vay
		lineageTag: 775b7c20-fc31-4135-8e47-a10678312515

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure Title_Loan_Trend =
			
			VAR SelectedRegion = SELECTEDVALUE(Dim_District[region], "Toàn quốc")
			VAR SelectedYear = SELECTEDVALUE(Dim_Date[Year], "1993 - 1998")
			RETURN
			"Quy mô giải ngân cho vay khu vực " & SelectedRegion & " (" & SelectedYear & ")"
		displayFolder: 5 Danh mục cho vay
		lineageTag: 7d376451-c365-424e-9e9e-c49f952752aa

	measure 'Bad Debt Exposure' =
			
			CALCULATE(
			    [Total Loan Amount],
			    Fact_Loan[status] IN {"B", "D"}
			)
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		displayFolder: 6 Rủi ro & cảnh báo sớm
		lineageTag: ac90bcfd-7aff-4658-9b77-5c78d598288d

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'NPL Rate' =
			
			DIVIDE(
			    [Bad Debt Exposure],
			    [Total Loan Amount],
			    0
			)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: 6 Rủi ro & cảnh báo sớm
		lineageTag: 6875d3e9-4918-499f-b00d-672caf2b44d0

	measure 'Ended Default Rate' =
			
			VAR EndedBadLoans = CALCULATE([Total Loans], Fact_Loan[status] = "B")
			VAR TotalEndedLoans = CALCULATE([Total Loans], Fact_Loan[status] IN {"A", "B"})
			RETURN
			DIVIDE(EndedBadLoans, TotalEndedLoans, 0)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: 6 Rủi ro & cảnh báo sớm
		lineageTag: d55e6e0d-0447-4b00-8326-95e3a6efc19a

	measure 'Active Delinquency Rate' =
			
			VAR ActiveBadLoans = CALCULATE([Total Loans], Fact_Loan[status] = "D")
			VAR TotalActiveLoans = CALCULATE([Total Loans], Fact_Loan[status] IN {"C", "D"})
			RETURN
			DIVIDE(ActiveBadLoans, TotalActiveLoans, 0)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: 6 Rủi ro & cảnh báo sớm
		lineageTag: 0eca9ae3-c1da-4bf1-9d4b-f4a332627e60

	measure 'Expected Loss' = [NPL Rate] * 0.45 * [Bad Debt Exposure]
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		displayFolder: 6 Rủi ro & cảnh báo sớm
		lineageTag: 5c0a282d-64ae-4d8b-bf3d-a65c8bca9d2f

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure Title_NPL_Trend =
			
			VAR SelectedRegion = SELECTEDVALUE(Dim_District[region], "Toàn hệ thống")
			RETURN
			"Tỷ lệ nợ xấu (NPL) khu vực " & SelectedRegion & " so với ngưỡng an toàn 3.0%"
		displayFolder: 6 Rủi ro & cảnh báo sớm
		lineageTag: a8566a65-ab52-4d99-9f84-950472bd530f

	column Column1
		dataType: string
		isHidden
		lineageTag: a0bd0b2d-396e-438c-bc24-79a0a6468db2
		summarizeBy: none
		sourceColumn: Column1

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	partition _M_RuiRo = m
		mode: import
		source =
				let
				    Source = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText("i44FAA==", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [Column1 = _t]),
				    #"Changed Type" = Table.TransformColumnTypes(Source,{{"Column1", type text}})
				in
				    #"Changed Type"

	annotation PBI_ResultType = Table


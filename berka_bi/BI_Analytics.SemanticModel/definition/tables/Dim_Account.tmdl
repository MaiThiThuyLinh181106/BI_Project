	partition Dim_Account = m
		mode: import
		queryGroup: Dimension
		source =
				let
				    Source = Csv.Document(   File.Contents(DataFolder & "account.csv"),[Delimiter=";", Columns=4, Encoding=1252, QuoteStyle=QuoteStyle.None]),
				    #"Promoted Headers1" = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    #"Changed Type" = Table.TransformColumnTypes(#"Promoted Headers1",{{"account_id", Int64.Type}, {"district_id", Int64.Type}, {"frequency", type text}, {"date", Int64.Type}}),
				    #"Duplicated Column" = Table.DuplicateColumn(#"Changed Type", "date", "date - Copy"),
				    #"Renamed Columns" = Table.RenameColumns(#"Duplicated Column",{{"date - Copy", "AccountOpenDate"}}),
				    #"Added Custom" = Table.AddColumn(#"Renamed Columns", "AccountOpenDate.1", each #date(
				    1900 + Number.IntegerDivide([date], 10000),
				    Number.Mod(Number.IntegerDivide([date], 100), 100),
				    Number.Mod([date], 100)
				)),
				    #"Removed Columns" = Table.RemoveColumns(#"Added Custom",{"AccountOpenDate", "AccountOpenDate.1"}),
				    #"Added Custom1" = Table.AddColumn(#"Removed Columns", "AccountOpenDate", each #date(
				    1900 + Number.IntegerDivide([date], 10000),
				    Number.Mod(Number.IntegerDivide([date], 100), 100),
				    Number.Mod([date], 100)
				)),
				    #"Removed Columns1" = Table.RemoveColumns(#"Added Custom1",{"date"}),
				    #"Replaced Value" = Table.ReplaceValue(#"Removed Columns1","POPLATEK MESICNE","Sao kê hàng tháng",Replacer.ReplaceText,{"frequency"}),
				    #"Replaced Value1" = Table.ReplaceValue(#"Replaced Value","POPLATEK TYDNE","Sao kê hàng tuần ",Replacer.ReplaceText,{"frequency"}),
				    #"Replaced Value2" = Table.ReplaceValue(#"Replaced Value1","POPLATEK PO OBRATU","Sao kê sau mỗi giao dịch ",Replacer.ReplaceText,{"frequency"})
				in
				    #"Replaced Value2"


	column SignedAmount
		dataType: decimal
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		lineageTag: c73dff07-d4a6-40d1-8893-93d22c661cd2
		summarizeBy: sum
		sourceColumn: SignedAmount

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	partition Fact_Transaction = m
		mode: import
		queryGroup: Fact
		source =
				let
				
				    Source = Csv.Document(File.Contents(DataFolder & "trans.csv"), [Delimiter=";", Encoding=65001, QuoteStyle=QuoteStyle.None]),
				    PromotedHeaders = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				
				    // xóa cột thừa (ngân hàng và tài khoản đối tác không dùng)
				    RemovedColumns = Table.RemoveColumns(PromotedHeaders, {"bank", "account"}),
				
				    // làm sạch khoảng trắng ở các cột chữ
				    TrimmedText = Table.TransformColumns(RemovedColumns, {
				        {"type", Text.Trim, type text},
				        {"operation", Text.Trim, type text},
				        {"k_symbol", Text.Trim, type text}
				    }),
				
				    // kiểu dữ liệu
				    TypedColumns = Table.TransformColumnTypes(TrimmedText, {
				        {"trans_id", Int64.Type},
				        {"account_id", Int64.Type},
				        {"date", Int64.Type},
				        {"amount", Currency.Type},
				        {"balance", Currency.Type}
				    }, "en-US"),
				
				    // YYMMDD thành date
				    AddTransDate = Table.AddColumn(TypedColumns, "TransDate", each
				        #date(
				            1900 + Number.IntegerDivide([date], 10000),
				            Number.Mod(Number.IntegerDivide([date], 100), 100),
				            Number.Mod([date], 100)
				        ), type date),
				    RemovedRawDate = Table.RemoveColumns(AddTransDate, {"date"}),
				
				    // xử lý lỗi ô trống
				    CleanNulls = Table.ReplaceValue(RemovedRawDate, null, "", Replacer.ReplaceValue, {"type", "operation", "k_symbol"}),
				
				    // tiền âm, dương có dấu
				    AddSignedAmount = Table.AddColumn(CleanNulls, "SignedAmount", each
				        if [type] = "PRIJEM" then [amount] else -[amount], Currency.Type),
				
				    // mã loại giao dịch để nối với Dim_TransType
				    AddTypeCode = Table.AddColumn(AddSignedAmount, "TransTypeCode", each
				        [type] & "|" & [operation] & "|" & [k_symbol], type text),
				
				    Reordered = Table.ReorderColumns(AddTypeCode,
				        {"trans_id", "account_id", "TransDate", "TransTypeCode", "type", "operation", "k_symbol", "amount", "SignedAmount", "balance"})
				in
				    Reordered

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table


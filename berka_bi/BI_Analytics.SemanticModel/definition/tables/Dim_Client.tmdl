	partition Dim_Client = m
		mode: import
		queryGroup: Dimension
		source = ```
				let
				    Source = Csv.Document(File.Contents(DataFolder & "client.csv"),[Delimiter=";", Columns=3, Encoding=1252, QuoteStyle=QuoteStyle.None]),
				    #"Promoted Headers1" = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    #"Changed Type" = Table.TransformColumnTypes(#"Promoted Headers1",{{"client_id", Int64.Type}, {"birth_number", Int64.Type}, {"district_id", Int64.Type}}),
				    #"Added Custom" = Table.AddColumn(#"Changed Type", "Gender", each if Number.Mod(Number.IntegerDivide([birth_number], 100), 100) > 50 then "Nữ" else "Nam"),
				    #"Added Custom1" = Table.AddColumn(#"Added Custom", "BirthDate", each #date(
				    1900 + Number.IntegerDivide([birth_number], 10000),
				    if Number.Mod(Number.IntegerDivide([birth_number], 100), 100) > 50 
				        then Number.Mod(Number.IntegerDivide([birth_number], 100), 100) - 50 
				        else Number.Mod(Number.IntegerDivide([birth_number], 100), 100),
				    Number.Mod([birth_number], 100)
				)),
				    #"Added Custom2" = Table.AddColumn(#"Added Custom1", "Age", each 1998 - (1900 + Number.IntegerDivide([birth_number], 10000))),
				    #"Added Custom3" = Table.AddColumn(#"Added Custom2", "AgeGroup", each if [Age] < 30 then "Dưới 30"
				else if [Age] <= 45 then "30 - 45"
				else if [Age] <= 60 then "46 - 60"
				else "Trên 60"),
				    #"Changed Type1" = Table.TransformColumnTypes(#"Added Custom3",{{"BirthDate", type date}, {"Age", Int64.Type}, {"AgeGroup", type text}, {"Gender", type text}}),
				    #"Added Custom4" = Table.AddColumn(#"Changed Type1", "AgeGroupOrder", each if [Age] < 30 then 1 else if [Age] <= 45 then 2 else if [Age] <= 60 then 3 else 4),
				    #"Changed Type2" = Table.TransformColumnTypes(#"Added Custom4",{{"AgeGroupOrder", Int64.Type}})
				in
				    #"Changed Type2"
				```

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table


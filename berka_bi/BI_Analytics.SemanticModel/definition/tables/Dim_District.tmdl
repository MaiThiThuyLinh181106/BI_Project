	partition Dim_District = m
		mode: import
		queryGroup: Dimension
		source = ```
				let
				    Source = Csv.Document(File.Contents(DataFolder & "district.csv"), [Delimiter=";", Columns=16, Encoding=1252, QuoteStyle=QuoteStyle.None]),
				    #"Promoted Headers" = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    
				    // Đổi tên các cột A1 - A16 theo quy chuẩn
				    #"Renamed Columns" = Table.RenameColumns(#"Promoted Headers", {
				        {"A1", "district_id"},
				        {"A2", "district_name"},
				        {"A3", "region"},
				        {"A4", "population"},
				        {"A5", "num_munip_lt_500"},
				        {"A6", "num_munip_500_1999"},
				        {"A7", "num_munip_2000_9999"},
				        {"A8", "num_munip_gt_10000"},
				        {"A9", "num_cities"},
				        {"A10", "ratio_urban_inhabitants"},
				        {"A11", "average_salary"},
				        {"A12", "unemploy_rate_95"},
				        {"A13", "unemploy_rate_96"},
				        {"A14", "num_entrep_per_1000"},
				        {"A15", "num_crimes_95"},
				        {"A16", "num_crimes_96"}
				    }),
				
				    // Xử lý giá trị "?" năm 1995 bằng cách lấy giá trị năm 1996 của huyện đó
				    #"Replaced Missing Unemploy95" = Table.ReplaceValue(
				        #"Renamed Columns",
				        each [unemploy_rate_95],
				        each if [unemploy_rate_95] = "?" or [unemploy_rate_95] = null or [unemploy_rate_95] = "" then [unemploy_rate_96] else [unemploy_rate_95],
				        Replacer.ReplaceValue,
				        {"unemploy_rate_95"}
				    ),
				    #"Replaced Missing Crimes95" = Table.ReplaceValue(
				        #"Replaced Missing Unemploy95",
				        each [num_crimes_95],
				        each if [num_crimes_95] = "?" or [num_crimes_95] = null or [num_crimes_95] = "" then [num_crimes_96] else [num_crimes_95],
				        Replacer.ReplaceValue,
				        {"num_crimes_95"}
				    ),
				
				    // Chuyển kiểu dữ liệu chuẩn
				    #"Changed Type" = Table.TransformColumnTypes(#"Replaced Missing Crimes95", {
				        {"district_id", Int64.Type},
				        {"district_name", type text},
				        {"region", type text},
				        {"population", Int64.Type},
				        {"num_munip_lt_500", Int64.Type},
				        {"num_munip_500_1999", Int64.Type},
				        {"num_munip_2000_9999", Int64.Type},
				        {"num_munip_gt_10000", Int64.Type},
				        {"num_cities", Int64.Type},
				        {"ratio_urban_inhabitants", type number},
				        {"average_salary", Int64.Type},
				        {"unemploy_rate_95", type number},
				        {"unemploy_rate_96", type number},
				        {"num_entrep_per_1000", Int64.Type},
				        {"num_crimes_95", Int64.Type},
				        {"num_crimes_96", Int64.Type}
				    }, "en-US")
				in
				    #"Changed Type"
				```

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table


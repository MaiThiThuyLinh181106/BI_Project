table Fact_Order
	lineageTag: e41e38e2-810b-4c03-aa68-6b146f35b4c0

	column order_id
		dataType: int64
		formatString: 0
		lineageTag: 2a789e47-58b4-4973-9524-49c28097baf5
		summarizeBy: sum
		sourceColumn: order_id

		annotation SummarizationSetBy = Automatic

	column account_id
		dataType: int64
		formatString: 0
		lineageTag: 3d2f5e0f-6589-4e9b-b960-ad4c226abaf7
		summarizeBy: none
		sourceColumn: account_id

		annotation SummarizationSetBy = Automatic

	column amount
		dataType: decimal
		lineageTag: ac347935-e6d7-4f1a-811b-b1dea4663354
		summarizeBy: sum
		sourceColumn: amount

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column k_symbol
		dataType: string
		lineageTag: 6a6b3b4f-2181-44be-a6f7-0b5ea5ba7cee
		summarizeBy: none
		sourceColumn: k_symbol

		annotation SummarizationSetBy = Automatic

	column PurposeName
		dataType: string
		lineageTag: be799393-55cc-489e-937e-db9fa9619143
		summarizeBy: none
		sourceColumn: PurposeName

		annotation SummarizationSetBy = Automatic

	partition Fact_Order = m
		mode: import
		queryGroup: Fact
		source =
				let
				
				    Source = Csv.Document(File.Contents(DataFolder & "order.csv"), [Delimiter=";", Encoding=65001, QuoteStyle=QuoteStyle.None]),
				    PromotedHeaders = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				
				    // xoá cột ngân hàng + người nhậ không dùng đến
				    RemovedColumns = Table.RemoveColumns(PromotedHeaders, {"bank_to", "account_to"}),
				
				    TrimmedText = Table.TransformColumns(RemovedColumns, {{"k_symbol", Text.Trim, type text}}),
				    TypedColumns = Table.TransformColumnTypes(TrimmedText, {
				        {"order_id", Int64.Type},
				        {"account_id", Int64.Type},
				        {"amount", Currency.Type}
				    }, "en-US"),
				
				    // dịch mục đích lệnh chi cho câu hỏi 14
				    PurposeMap = [POJISTNE = "Bảo hiểm", SIPO = "Chi tiêu gia đình", LEASING = "Thuê tài sản", UVER = "Trả nợ vay"],
				    AddPurposeName = Table.AddColumn(TypedColumns, "PurposeName", each
				        if [k_symbol] = null or [k_symbol] = "" then "Không xác định"
				        else Record.FieldOrDefault(PurposeMap, [k_symbol], [k_symbol]), type text)
				in
				    AddPurposeName

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table


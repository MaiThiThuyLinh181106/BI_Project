	partition ML_CustomerSegment = m
		mode: import
		queryGroup: Dimension
		source =
				let
				    Source = Csv.Document(
				        File.Contents(DataFolder & "ml_customer_segments.csv"),
				        [Delimiter=",", Columns=8, Encoding=65001, QuoteStyle=QuoteStyle.None]
				    ),
				    PromotedHeaders = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    ChangedType = Table.TransformColumnTypes(
				        PromotedHeaders,
				        {
				            {"account_id", Int64.Type},
				            {"Recency", type number},
				            {"Frequency", type number},
				            {"Monetary", Currency.Type},
				            {"AvgBalance", Currency.Type},
				            {"Cluster_ID", Int64.Type},
				            {"Segment_Name", type text},
				            {"Segment_Order", Int64.Type}
				        },
				        "en-US"
				    ),
				    ToInt = Table.TransformColumnTypes(
				        ChangedType,
				        {{"Recency", Int64.Type}, {"Frequency", Int64.Type}}
				    )
				in
				    ToInt

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

